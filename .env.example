# Copy to .env for local testing (`npm start`), and add the same values in
# Netlify: Site configuration > Environment variables. Never commit real keys.

# Public site address, no trailing slash. Used in emailed payment links.
SITE_URL=http://localhost:8888

# Password for the bookings admin page at /admin/. Use a long, unique password.
ADMIN_PASSWORD=

# Yoco secret key (Yoco portal > Selling Online > Payment Gateway). Use sk_test_ for testing.
YOCO_SECRET_KEY=
# Printed once by `npm run register-webhook`.
YOCO_WEBHOOK_SECRET=

# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Lilahleo <bookings@lilahleo.co.za>
OWNER_EMAIL=info@lilahleo.co.za

# Local runs only: store bookings as JSON files in this folder instead of Netlify Blobs.
LOCAL_STORE_DIR=.data/bookings
